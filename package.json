{
  "name": "enterprise-e-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @commerce/database generate",
    "db:migrate": "pnpm --filter @commerce/database migrate",
    "db:seed": "pnpm --filter @commerce/database seed",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.4.0"
  }
}
